{
  "name": "@openeuler/agent-nl2sql",
  "version": "0.1.0",
  "description": "NL2SQL Agent — 自然语言转 Elasticsearch 只读查询，通过本地 NL2SQL Web API 执行",
  "type": "module",
  "bin": {
    "nl2sql-agent": "./bin/configure.mjs",
    "nl2sql-setup": "./bin/nl2sql-setup.mjs"
  },
  "files": [
    "opencode_plugin/",
    "bin/",
    "lib/",
    "README.md"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "pack:variant": "node scripts/build-package.mjs",
    "ci:verify-artifacts": "node scripts/verify-ci-artifacts.mjs",
    "test:install-contract": "node tests/test-install-contract.mjs",
    "test": "node tests/test-install-contract.mjs"
  },
  "wittyAgentDistribution": {
    "packageNames": {
      "organization": "@openeuler/agent-nl2sql",
