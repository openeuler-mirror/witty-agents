{
  "name": "@openeuler/agent-openeuler-ops",
  "version": "1.0.0",
  "description": "openEuler 运维 Agent — 覆盖16个场景的智能运维助手，在 opencode 中直接对话使用",
  "type": "module",
  "bin": {
    "openeuler-ops-agent": "./bin/cli.js"
  },
  "files": [
    "agent.md",
    "bin/",
    "lib/",
    "scripts/",
    "install.sh",
    "README.md"
  ],
  "scripts": {
