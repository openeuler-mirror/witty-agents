{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "crash-report-schema.json",
  "title": "内核崩溃分析报告",
  "description": "神农诊断 Agent 产出的最终内核崩溃诊断报告 Schema（与 report.html 结构一致）。",
  "type": "object",
  "required": [
    "report_id",
    "parse_log_range",
    "host_base_info",
    "crash_feature_info",
    "root_cause_analysis",
    "diagnosis_repair_result",
    "workflow_trace"
  ],
  "additionalProperties": false,
  "properties": {
    "report_id": {
      "type": "string",
      "description": "报告标识，格式 <hostname>-<start_date>-<end_date>。"
    },
    "parse_log_range": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "已分析日志来源列表。"
    },
    "host_base_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_name",
        "kernel_version",
        "cpu_model",
        "machine_model",
        "cpu_num",
        "memory_size",
        "modules"
      ],
      "properties": {
        "host_name": {
          "type": "string"
        },
        "kernel_version": {
          "type": "string"
        },
        "cpu_model": {
          "type": "string"
        },
        "machine_model": {
          "type": "string"
        },
        "cpu_num": {
          "type": "integer",
          "minimum": 0
        },
        "memory_size": {
          "type": "string"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "crash_feature_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crash_time",
        "signature",
        "bug_type",
        "bug_key",
        "bug_summary",
        "rip",
        "rip_function",
        "rip_offset",
        "related_modules",
        "call_trace_signature",
        "call_trace_text"
      ],
      "properties": {
        "crash_time": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "bug_type": {
          "type": "string"
        },
        "bug_key": {
          "type": "string"
        },
        "bug_summary": {
          "type": "string"
        },
        "rip": {
          "type": "string"
        },
        "rip_function": {
          "type": "string"
        },
        "rip_offset": {
          "type": "string"
        },
        "related_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "call_trace_signature": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "call_trace_text": {
          "type": "string"
        },
        "log_features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "related_ref": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string"
                },
                "lines": {
                  "type": "string"
                }
              }
            },
            "related_errors": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "lines": {
                    "type": "string"
                  },
                  "line": {
                    "type": "string"
                  },
                  "relevance": {
                    "type": "string",
                    "enum": [
                      "强相关",
                      "一般相关",
                      "弱相关"
                    ],
                    "description": "该报错行与崩溃的相关性：强相关=直接导致/触发崩溃的报错；一般相关=与崩溃同子系统/上下文但非直接原因；弱相关=背景噪声或无关日志。"
                  },
                  "desc": {
                    "type": "string",
                    "description": "该行日志的含义说明（解释这行日志是什么意思）。"
                  }
                }
              }
            },
            "repeated": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "count": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  },
                  "window": {
                    "type": "string"
                  },
                  "ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "file": {
                        "type": "string"
                      },
                      "lines": {
                        "type": "string"
                      }
                    }
                  },
                  "note": {
                    "type": "string"
                  },
                  "examples": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "relevance": {
                    "type": "string",
                    "enum": [
                      "强相关",
                      "一般相关",
                      "弱相关"
                    ],
                    "description": "该重复日志与崩溃的相关性：强相关=直接导致/触发崩溃；一般相关=同子系统/上下文相关但非直接原因；弱相关=背景噪声或无关日志。"
                  },
                  "desc": {
                    "type": "string",
                    "description": "该行日志的含义说明（解释这行日志是什么意思）。"
                  }
                }
              }
            },
            "other": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "count": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  },
                  "span": {
                    "type": "string"
                  },
                  "ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "file": {
                        "type": "string"
                      },
                      "lines": {
                        "type": "string"
                      }
                    }
                  },
                  "note": {
                    "type": "string"
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "relevance": {
                    "type": "string",
                    "enum": [
                      "强相关",
                      "一般相关",
                      "弱相关"
                    ],
                    "description": "该异常特征与崩溃的相关性：强相关=直接导致/触发崩溃；一般相关=同子系统/上下文相关但非直接原因；弱相关=背景噪声或无关日志。"
                  },
                  "desc": {
                    "type": "string",
                    "description": "该行日志的含义说明（解释这行日志是什么意思）。"
                  }
                }
              }
            }
          }
        },
        "raw_crash_log": {
          "type": "string",
          "description": "完整原始崩溃日志段（逐字复制自 dmesg/vmcore-dmesg）：从崩溃首行（如 Unable to handle/BUG/panic）起，到 Code: 机器码行（无 Code 行则到 Call trace 结束）止的连续原文，含 ESR/寄存器/Call trace 全部行。HTML「原始崩溃日志」区优先渲染本字段，保证与「如何阅读这段日志」指南逐项对应。"
        }
      }
    },
    "root_cause_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion",
        "event_scene",
        "propagation_chain",
        "reasoning_flow",
        "deep",
        "overview_brief",
        "trigger_scenario"
      ],
      "properties": {
        "conclusion": {
          "type": "string"
        },
        "standard_solution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string"
            },
            "basis": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            },
            "patch_list": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sha": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "diff": {
                    "type": "string"
                  }
                }
              }
            },
            "detail": {
              "type": "string"
            },
            "rollback": {
              "type": "string",
              "description": "回退方案：补丁/配置合入失败或引发回归时的回退步骤（如卸载热补丁、还原配置、重启回滚内核等）。"
            },
            "verification": {
              "type": "string",
              "description": "验证方案：合入后如何验证修复生效（编译无告警、压力回归、观察 dmesg 无新 Oops、监控同类 panic 建簇等）。"
            },
            "brief": {
              "type": "string",
              "description": "规避手段一句话说明：给出的是什么补丁，不含编译/灰度等过程。"
            },
            "fixed_brief": {
              "type": "string",
              "description": "上游修复状态一句话：哪个内核版本的哪个补丁修复了什么问题（该补丁即生成 patch 的来源）。"
            },
            "claim_tag": {
              "type": "string",
              "description": "修复主张标签：一句话概括修复方案的性质与覆盖范围。"
            },
            "short": {
              "type": "string",
              "description": "规避手段短描述：分「要做什么·为什么·怎么做」三句，通俗书面、只写结论。"
            },
            "fixed_in": {
              "type": "string",
              "description": "修复版本判定：哪个内核版本/commit 首次引入对应修复。"
            },
            "method_steps": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "合入步骤：可执行步骤列表。"
            }
          },
          "required": [
            "type",
            "brief",
            "fixed_brief"
          ]
        },
        "temporary_workaround": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "case_refs": {
              "type": "array",
              "description": "明确提供该临时措施的案例标识或案例标题；为空时不在报告中展示临时缓解卡片。",
              "items": {
                "type": "string"
              }
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "risk": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            },
            "title": {
              "type": "string",
              "description": "临时规避方案标题（可选，一句话）。"
            }
          }
        },
        "event_scene": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "participants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "process",
                      "cpu",
                      "hardware",
                      "kernel"
                    ],
                    "description": "泳道类型：process=进程、cpu=CPU 核、hardware=外部硬件、kernel=内核内部活动（归入 CPU 泳道）。"
                  },
                  "init": {
                    "type": "string"
                  },
                  "tip": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string"
                  }
                }
              }
            },
            "gvars": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "k": {
                    "type": "string"
                  },
                  "n": {
                    "type": "string"
                  }
                }
              }
            },
            "ginit": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "k": {
                    "type": "string"
                  },
                  "v": {
                    "type": "string"
                  }
                }
              }
            },
            "anchor": {
              "type": "string"
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "t": {
                    "type": "string"
                  },
                  "origin": {
                    "type": "string"
                  },
                  "evidence_level": {
                    "type": "string",
                    "enum": [
                      "L1",
                      "L2",
                      "L3"
                    ],
                    "description": "主时序证据等级：L1 日志/寄存器/源码直接确认，L2 由调用栈与源码强推断，L3 一般机制补全（不得进入主时序）。"
                  },
                  "evidence": {
                    "type": "string",
                    "description": "支持该事件的日志行、寄存器、源码位置或推断依据。"
                  },
                  "src": {
                    "type": "string"
                  },
                  "m": {
                    "type": "string",
                    "enum": [
                      "user",
                      "sys",
                      "kern",
                      "hw"
                    ],
                    "description": "事件执行模式：user=用户态、sys=用户→内核、kern=内核态、hw=硬件。"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "call",
                      "irq",
                      "softirq",
                      "hw",
                      "mutex",
                      "alloc",
                      "race",
                      "free",
                      "global",
                      "crash"
                    ],
                    "description": "事件类型：call=调用、irq=中断、softirq=软中断、hw=硬件、mutex=加锁、alloc=分配、race=竞态、free=释放、global=全局、crash=崩溃。"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "dt_ms": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "val": {
                    "type": "string"
                  },
                  "full": {
                    "type": "string"
                  },
                  "g": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "v": {
                          "type": "string"
                        },
                        "n": {
                          "type": "string"
                        },
                        "f": {
                          "type": "string"
                        },
                        "t": {
                          "type": "string"
                        },
                        "dir": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "from",
                  "to",
                  "kind",
                  "m",
                  "t",
                  "dt_ms"
                ]
              }
            }
          }
        },
        "propagation_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "src_dir": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "string"
              },
              "stack": {
                "type": "string"
              },
              "fn_ctx": {
                "type": "string"
              },
              "crash": {
                "type": "boolean"
              },
              "source_url": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "io": {
                      "type": "string"
                    },
                    "reg": {
                      "type": "string"
                    },
                    "n": {
                      "type": "string"
                    },
                    "formal": {
                      "type": "string"
                    },
                    "v": {
                      "type": "string"
                    },
                    "bad": {
                      "type": "boolean"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "reasoning_flow": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stage": {
                "type": "string"
              },
              "stage_name": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "short": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "ev_plain": {
                "type": "boolean"
              },
              "path_mini": {
                "type": "array"
              },
              "refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "anchor": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              },
              "branch": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "verdict": {
                    "type": "string"
                  },
                  "relevance": {
                    "type": "string",
                    "enum": [
                      "强相关",
                      "部分相关",
                      "弱相关"
                    ],
                    "description": "该上游 commit/issue/邮件与本次崩溃的相关度：强相关=补丁直接修复崩溃函数/路径(confirmed)；部分相关=同子系统不同触发点(same_area)；弱相关=与崩溃路径无关或原文获取失败(not_relevant/unverified)。"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "deep": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "flow",
            "evidence"
          ],
          "properties": {
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "summary",
                  "reasoning"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "reasoning": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "step",
                        "detail",
                        "evidence"
                      ],
                      "properties": {
                        "step": {
                          "type": "string"
                        },
                        "detail": {
                          "type": "string"
                        },
                        "evidence": {
                          "type": "string"
                        },
                        "conclusion": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "connect": {
                    "type": "string",
                    "description": "四部分证据之间的逻辑串联过渡句（第 2/3/4 部分使用）。"
                  }
                }
              }
            },
            "flow": {
              "type": "string",
              "description": "故障流程梳理：只描述触发流程（箭头链），不含根因判定与处置方向。"
            },
            "lead": {
              "type": "string",
              "description": "根因一句话结论（技术口径）。"
            },
            "mechanism_summary": {
              "type": "string",
              "description": "给读者看的 1-3 句人话概述：发生了什么、为什么崩溃、影响是什么。"
            },
            "judgment": {
              "type": "string",
              "description": "当前根因判断与处置方向。"
            },
            "mechanism": {
              "type": "string",
              "description": "技术触发链，供泳道图下方详细链条展示。"
            },
            "confidence": {
              "type": "string",
              "description": "置信度说明。"
            },
            "scope": {
              "type": "string",
              "description": "影响范围与受影响版本。"
            }
          }
        },
        "overview_brief": {
          "type": "string",
          "description": "故障总览一句话通俗结论：发生了什么、为什么、是否与业务/硬件有关；不含函数名/寄存器/地址/版本/commit/PID，不含与结论无关的信息。"
        },
        "trigger_scenario": {
          "type": "string",
          "description": "易触发场景：在某场景下某主体做某操作就容易触发；不写具体业务名。"
        }
      }
    },
    "diagnosis_repair_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "internal_kernel_result",
        "community_kernel_result",
        "community_meetings",
        "online_result"
      ],
      "properties": {
        "internal_kernel_result": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "knowledge_id": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "anchor": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "bug_summary": {
                "type": "string"
              },
              "match_score": {
                "type": "string",
                "enum": [
                  "高",
