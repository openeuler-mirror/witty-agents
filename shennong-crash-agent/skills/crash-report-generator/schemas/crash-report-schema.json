{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "crash-report-schema.json",
  "title": "内核崩溃分析报告",
  "description": "神农诊断 Agent 产出的最终内核崩溃诊断报告 Schema（与 report.html 结构一致）。",
  "type": "object",
  "required": [
    "report_id",
    "parse_log_range",
    "host_base_info",
    "crash_feature_info",
    "root_cause_analysis",
    "diagnosis_repair_result",
    "workflow_trace"
  ],
  "additionalProperties": false,
  "properties": {
    "report_id": {
      "type": "string",
      "description": "报告标识，格式 <hostname>-<start_date>-<end_date>。"
    },
    "parse_log_range": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "已分析日志来源列表。"
    },
    "host_base_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_name",
        "kernel_version",
        "cpu_model",
        "machine_model",
        "cpu_num",
        "memory_size",
        "modules"
      ],
      "properties": {
        "host_name": {
          "type": "string"
        },
        "kernel_version": {
          "type": "string"
        },
        "cpu_model": {
          "type": "string"
        },
        "machine_model": {
          "type": "string"
        },
        "cpu_num": {
          "type": "integer",
          "minimum": 0
        },
        "memory_size": {
          "type": "string"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "crash_feature_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crash_time",
        "signature",
        "bug_type",
        "bug_key",
        "bug_summary",
        "rip",
        "rip_function",
        "rip_offset",
        "related_modules",
        "call_trace_signature",
        "call_trace_text"
      ],
      "properties": {
        "crash_time": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "bug_type": {
          "type": "string"
        },
        "bug_key": {
          "type": "string"
        },
        "bug_summary": {
          "type": "string"
        },
        "rip": {
          "type": "string"
        },
        "rip_function": {
          "type": "string"
        },
        "rip_offset": {
          "type": "string"
        },
        "related_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "call_trace_signature": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "call_trace_text": {
          "type": "string"
        },
        "log_features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "related_ref": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string"
                },
                "lines": {
                  "type": "string"
                }
              }
            },
            "related_errors": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "lines": {
                    "type": "string"
                  },
                  "line": {
                    "type": "string"
                  },
                  "relevance": {
                    "type": "string",
                    "enum": [
                      "强相关",
                      "一般相关",
                      "弱相关"
                    ],
                    "description": "该报错行与崩溃的相关性：强相关=直接导致/触发崩溃的报错；一般相关=与崩溃同子系统/上下文但非直接原因；弱相关=背景噪声或无关日志。"
                  }
                }
              }
            },
            "repeated": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "count": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  },
                  "window": {
                    "type": "string"
                  },
                  "ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "file": {
                        "type": "string"
                      },
                      "lines": {
                        "type": "string"
                      }
                    }
                  },
                  "note": {
                    "type": "string"
                  },
                  "examples": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "relevance": {
                    "type": "string",
                    "enum": [
                      "强相关",
                      "一般相关",
                      "弱相关"
                    ],
                    "description": "该重复日志与崩溃的相关性：强相关=直接导致/触发崩溃；一般相关=同子系统/上下文相关但非直接原因；弱相关=背景噪声或无关日志。"
                  }
                }
              }
            },
            "other": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "count": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  },
                  "span": {
                    "type": "string"
                  },
                  "ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "file": {
                        "type": "string"
                      },
                      "lines": {
                        "type": "string"
                      }
                    }
                  },
                  "note": {
                    "type": "string"
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "relevance": {
                    "type": "string",
                    "enum": [
                      "强相关",
                      "一般相关",
                      "弱相关"
                    ],
                    "description": "该异常特征与崩溃的相关性：强相关=直接导致/触发崩溃；一般相关=同子系统/上下文相关但非直接原因；弱相关=背景噪声或无关日志。"
                  }
                }
              }
            }
          }
        }
      }
    },
    "root_cause_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion",
        "event_scene",
        "propagation_chain",
        "reasoning_flow",
        "deep"
      ],
      "properties": {
        "conclusion": {
          "type": "string"
        },
        "standard_solution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string"
            },
            "claim_tag": {
              "type": "string"
            },
            "short": {
              "type": "string"
            },
            "basis": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            },
            "fixed_in": {
              "type": "string"
            },
            "patch_list": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sha": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "diff": {
                    "type": "string"
                  }
                }
              }
            },
            "method_steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "detail": {
              "type": "string"
            },
            "rollback": {
              "type": "string",
              "description": "回退方案：补丁/配置合入失败或引发回归时的回退步骤（如卸载热补丁、还原配置、重启回滚内核等）。"
            },
            "verification": {
              "type": "string",
              "description": "验证方案：合入后如何验证修复生效（编译无告警、压力回归、观察 dmesg 无新 Oops、监控同类 panic 建簇等）。"
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "temporary_workaround": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "risk": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          }
        },
        "event_scene": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "participants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "init": {
                    "type": "string"
                  },
                  "tip": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string"
                  }
                }
              }
            },
            "gvars": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "k": {
                    "type": "string"
                  },
                  "n": {
                    "type": "string"
                  }
                }
              }
            },
            "ginit": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "k": {
                    "type": "string"
                  },
                  "v": {
                    "type": "string"
                  }
                }
              }
            },
            "anchor": {
              "type": "string"
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "t": {
                    "type": "string"
                  },
                  "origin": {
                    "type": "string"
                  },
                  "src": {
                    "type": "string"
                  },
                  "m": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "dt_ms": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "val": {
                    "type": "string"
                  },
                  "full": {
                    "type": "string"
                  },
                  "g": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "v": {
                          "type": "string"
                        },
                        "n": {
                          "type": "string"
                        },
                        "f": {
                          "type": "string"
                        },
                        "t": {
                          "type": "string"
                        },
                        "dir": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "propagation_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "src_dir": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "string"
              },
              "stack": {
                "type": "string"
              },
              "fn_ctx": {
                "type": "string"
              },
              "crash": {
                "type": "boolean"
              },
              "source_url": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "io": {
                      "type": "string"
                    },
                    "reg": {
                      "type": "string"
                    },
                    "n": {
                      "type": "string"
                    },
                    "formal": {
                      "type": "string"
                    },
                    "v": {
                      "type": "string"
                    },
                    "bad": {
                      "type": "boolean"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "reasoning_flow": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stage": {
                "type": "string"
              },
              "stage_name": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "short": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "ev_plain": {
                "type": "boolean"
              },
              "path_mini": {
                "type": "array"
              },
              "refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "anchor": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              },
              "branch": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
              "verdict": {
                "type": "string"
              },
              "relevance": {
                "type": "string",
                "enum": [
                  "强相关",
                  "部分相关",
                  "弱相关"
                ],
                "description": "该上游 commit/issue/邮件与本次崩溃的相关度：强相关=补丁直接修复崩溃函数/路径(confirmed)；部分相关=同子系统不同触发点(same_area)；弱相关=与崩溃路径无关或原文获取失败(not_relevant/unverified)。"
              },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "deep": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lead": {
              "type": "string"
            },
            "mechanism": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            }
          }
        }
      }
    },
    "diagnosis_repair_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "internal_kernel_result",
        "community_kernel_result",
        "community_meetings",
        "online_result"
      ],
      "properties": {
        "internal_kernel_result": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "knowledge_id": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "anchor": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "bug_summary": {
                "type": "string"
              },
              "match_score": {
                "type": "string",
                "enum": [
                  "高",
                  "中",
                  "低"
                ]
              },
              "match_level": {
                "type": "string",
                "enum": [
                  "L1",
                  "L2",
                  "L3"
                ]
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "same_area",
                  "not_relevant",
                  "unverified"
                ]
              },
              "kernel_versions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "affected_component": {
                "type": "string"
              },
              "case_count": {
                "type": [
                  "integer",
                  "number"
                ]
              },
              "fingerprints": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "root_cause": {
                "type": "string"
              },
              "solution": {
                "type": "string"
              },
              "hotpatch": {
                "type": "string"
              },
              "history": {
                "type": "object",
                "additionalProperties": true
              },
              "corroboration": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "dimension": {
                      "type": "string"
                    },
                    "verdict": {
                      "type": "string"
                    },
                    "current": {
                      "type": "string"
                    },
                    "reference": {
                      "type": "string"
                    }
                  }
                }
              },
              "applicability": {
                "type": [
                  "string",
                  "object"
                ]
              }
            }
          }
        },
        "community_kernel_result": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "kind": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "list": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "anchor": {
                "type": "string"
              },
              "kernel_version": {
                "type": "string"
              },
              "verdict": {
                "type": "string"
              },
              "patch_url": {
                "type": "string"
              },
              "excerpt": {
                "type": "string"
              },
              "how": {
                "type": "string"
              },
              "patch_ref": {
                "type": "string"
              },
              "lead": {
                "type": "string"
              }
            }
          }
        },
        "community_meetings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "kind": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "list": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "anchor": {
                "type": "string"
              },
              "verdict": {
                "type": "string"
              },
              "patch_url": {
                "type": "string"
              },
              "excerpt": {
                "type": "string"
              },
              "how": {
                "type": "string"
              },
              "patch_ref": {
                "type": "string"
              }
            }
          }
        },
        "online_result": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "kind",
              "title"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "commit",
                  "issue",
                  "mail"
                ]
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "list": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "anchor": {
                "type": "string"
              },
              "kernel_version": {
                "type": "string"
              },
              "verdict": {
                "type": "string"
              },
              "excerpt": {
                "type": "string"
              },
              "how": {
                "type": "string"
              },
              "patch_ref": {
                "type": "string"
              },
              "patch_url": {
                "type": "string"
              },
              "lead": {
                "type": "string"
              },
              "sha": {
                "type": "string"
              },
              "phenomenon": {
                "type": "string"
              },
              "root_cause": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fix_scope": {
                "type": "string"
              },
              "diff": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "workflow_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "step_count",
        "steps"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "opencode_export",
            "manual"
          ]
        },
        "session_id": {
          "type": "string"
        },
        "total_duration_ms": {
          "type": [
            "integer",
            "number"
          ],
          "minimum": 0
        },
        "step_count": {
          "type": "integer",
          "minimum": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "stage",
              "decision",
              "status"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1
              },
              "stage": {
                "type": "string",
                "enum": [
                  "init",
                  "baseline_collection",
                  "crash_feature_extraction",
                  "log_detection",
                  "knowledge_retrieval",
                  "community_retrieval",
                  "online_retrieval",
                  "deep_analysis",
                  "root_cause_validation",
                  "report_generation"
                ]
              },
              "decision": {
                "type": "string"
              },
              "src": {
                "type": "string"
              },
              "observations": {
                "type": "string"
              },
              "judgment": {
                "type": "string"
