{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shennong-crash-agent/schemas/core-report-schema.json",
  "title": "CoreCrashReport",
  "description": "用户视角的精简崩溃报告，从完整 DiagnoseReport 提取核心字段生成，便于运维/管理层快速理解崩溃与处置方案。字段提取规则由 x-source/x-default/x-transform 元数据驱动，generate_core_report.py 读取本 schema 自动提取，无需硬编码字段映射。",
  "type": "object",
  "required": [
    "report_id",
    "crash_time",
    "host",
    "bug_summary",
    "call_trace",
    "root_cause",
    "solution",
    "match_info"
  ],
  "additionalProperties": false,
  "properties": {
    "report_id": {
      "type": "string",
      "description": "报告唯一标识，形如 <hostname>-<start_date>-<end_date>",
      "x-source": "report_id"
    },
    "crash_time": {
      "type": "string",
      "description": "崩溃发生时间（ISO 8601 或 unknown）",
      "x-source": "crash_feature_info.crash_time",
      "x-default": "unknown"
    },
    "host": {
      "type": "object",
      "description": "宿主机精简信息（从 host_base_info 取整个对象，但按本 schema 的 properties 字段名过滤，modules 等未定义字段自动丢弃）",
      "x-source": "host_base_info",
      "required": ["host_name", "kernel_version", "cpu_model", "machine_model", "cpu_num", "memory_size"],
      "additionalProperties": false,
      "properties": {
        "host_name": { "type": "string" },
        "kernel_version": { "type": "string" },
        "cpu_model": { "type": "string" },
        "machine_model": { "type": "string" },
        "cpu_num": { "type": "integer" },
        "memory_size": { "type": "string" }
      }
    },
    "bug_summary": {
      "type": "string",
      "description": "一句话描述崩溃 bug",
      "x-source": "crash_feature_info.bug_summary"
    },
    "call_trace": {
      "type": "array",
      "description": "崩溃调用栈关键函数名（按调用顺序），取自 call_trace_signature",
      "items": { "type": "string" },
      "x-source": "crash_feature_info.call_trace_signature"
    },
    "root_cause": {
      "type": "string",
      "description": "根因分析（自然语言段落）",
      "x-source": "root_cause_analysis.root_cause"
    },
    "solution": {
      "type": "string",
      "description": "解决方案/处置建议（自然语言段落）",
      "x-source": "root_cause_analysis.solution"
    },
    "match_info": {
      "type": "object",
      "description": "知识库匹配情况精简摘要（不包含完整案例原文）。优先取 internal_kernel_result[0]，其次 community_kernel_result[0]，都空则 matched=false",
      "x-transform": "match_info",
      "required": ["matched", "knowledge_id", "source", "match_score"],
      "additionalProperties": false,
      "properties": {
        "matched": {
          "type": "boolean",
          "description": "是否命中内部/社区知识库案例"
        },
        "knowledge_id": {
          "type": "string",
          "description": "命中的案例标识（无匹配时为空字符串）"
        },
        "source": {
          "type": "string",
          "description": "案例来源（如 issue/kernel/community；无匹配时为空字符串）"
        },
        "match_score": {
          "type": "string",
          "description": "匹配等级（高/中/低；无匹配时为空字符串）"
        }
      }
    }
  }
}
