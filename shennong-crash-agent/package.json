{
  "name": "@openeuler/agent-shennong-crash",
  "version": "0.10.5",
  "description": "Minimal OpenCode plugin for kernel crash diagnosis using Shennong agent and core skills.",
  "keywords": ["shennong", "kernel-crash", "diagnosis", "opencode-plugin"],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "bin",
    "lib",
    "frameworks",
    "agent.md"
  ],
  "bin": {
    "shennong-setup": "./bin/shennong-setup.mjs",
    "shennong-configure": "./bin/shennong-configure.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/validate-dist.mjs",
    "validate:dist": "node scripts/validate-dist.mjs",
    "pack:variant": "node scripts/build-package.mjs",
    "pack:online": "node scripts/build-package.mjs --variant=online",
    "pack:offline": "node scripts/build-package.mjs --variant=offline",
    "test:install-contract": "node tests/test-install-contract.mjs",
    "ci:prepare-ocr": "node scripts/prepare-ocr-models.mjs",
    "ci:verify-artifacts": "node scripts/verify-ci-artifacts.mjs"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.1.19"
  }
}
